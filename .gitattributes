# Keep source and project metadata consistent between macOS and Windows.
* text=auto eol=lf

*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.md text eol=lf
*.uid text eol=lf
*.import text eol=lf
*.py text eol=lf
*.mjs text eol=lf

# Do not normalize packaged, media, font, or export binaries.
*.png -text
*.jpg -text
*.jpeg -text
*.webp -text
*.gif -text
*.svg -text
*.wav -text
*.ogg -text
*.mp3 -text
*.ttf -text
*.otf -text
*.pdf -text
*.zip -text
*.exe -text
*.dmg -text
